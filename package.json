{
  "name": "egitim-yonetim-sistemi",
  "productName": "egitim-yonetim-sistemi",
  "version": "0.1.5",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "yarn rebuild:electron && electron-forge start",
    "package": "electron-forge package",
    "make": "yarn db:generate && electron-forge make",
    "lint": "eslint --ext .ts,.tsx .",
    "packages:check": "npx npm-check-updates",
    "packages:update": "npx npm-check-updates -u && yarn install",
    "rebuild:system": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "yarn rebuild:electron",
    "db:generate": "yarn rebuild:system && drizzle-kit generate:sqlite && yarn rebuild:electron",
    "db:migrate": "yarn rebuild:system && drizzle-kit migrate",
    "db:push": "yarn rebuild:system && drizzle-kit push:sqlite",
    "db:studio": "yarn rebuild:system && drizzle-kit studio",
    "postinstall": "yarn rebuild:electron"
  },
  "keywords": [],
  "author": {
    "name": "Burak",
    "email": "burak@90pixel.com"
  },
  "license": "MIT",
  "devDependencies": {
